from flask import Flask, render_template_string, request

app = Flask(__name__)

HTML = """
<!DOCTYPE html>
<html>
<head>
    <title>Restaurant Seat Booking</title>

    <style>
        body{
            font-family: Arial, sans-serif;
            background:#f4f4f4;
            margin:0;
            padding:0;
        }

        .container{
            width:500px;
            margin:50px auto;
            background:white;
            padding:30px;
            border-radius:10px;
            box-shadow:0 0 10px rgba(0,0,0,0.2);
        }

        h1{
            text-align:center;
            color:#2c3e50;
        }

        label{
            display:block;
            margin-top:15px;
            font-weight:bold;
        }

        input, select{
            width:100%;
            padding:10px;
            margin-top:5px;
            border:1px solid #ccc;
            border-radius:5px;
        }

        button{
            width:100%;
            margin-top:20px;
            padding:12px;
            border:none;
            background:#27ae60;
            color:white;
            font-size:16px;
            border-radius:5px;
            cursor:pointer;
        }

        button:hover{
            background:#219150;
        }

        .success{
            margin-top:20px;
            background:#d4edda;
            color:#155724;
            padding:15px;
            border-radius:5px;
        }
    </style>
</head>
<body>

<div class="container">

    <h1>🍽 Restaurant Seat Booking</h1>

    <form method="post">

        <label>Customer Name</label>
        <input type="text" name="name" required>

        <label>Mobile Number</label>
        <input type="text" name="mobile" required>

        <label>Guests</label>
        <input type="number" name="guests" min="1" required>

        <label>Table</label>
        <select name="table">
            <option>Table 1 (2 Seats)</option>
            <option>Table 2 (4 Seats)</option>
            <option>Table 3 (6 Seats)</option>
            <option>VIP Table (8 Seats)</option>
        </select>

        <label>Date</label>
        <input type="date" name="date" required>

        <label>Time</label>
        <select name="time">
            <option>12:00 PM</option>
            <option>01:00 PM</option>
            <option>02:00 PM</option>
            <option>07:00 PM</option>
            <option>08:00 PM</option>
            <option>09:00 PM</option>
        </select>

        <button type="submit">
            Book Table
        </button>

    </form>

    {% if booking %}
    <div class="success">
        <h3>✅ Booking Confirmed</h3>

        <p><b>Name:</b> {{ booking.name }}</p>
        <p><b>Mobile:</b> {{ booking.mobile }}</p>
        <p><b>Guests:</b> {{ booking.guests }}</p>
        <p><b>Table:</b> {{ booking.table }}</p>
        <p><b>Date:</b> {{ booking.date }}</p>
        <p><b>Time:</b> {{ booking.time }}</p>
    </div>
    {% endif %}

</div>

</body>
</html>
"""

@app.route("/", methods=["GET", "POST"])
def home():

    booking = None

    if request.method == "POST":
        booking = {
            "name": request.form["name"],
            "mobile": request.form["mobile"],
            "guests": request.form["guests"],
            "table": request.form["table"],
            "date": request.form["date"],
            "time": request.form["time"]
        }

    return render_template_string(HTML, booking=booking)

if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5000)
