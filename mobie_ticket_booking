<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Movie Ticket Booking</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Segoe UI, sans-serif;
}

body{
    background:linear-gradient(135deg,#141e30,#243b55);
    min-height:100vh;
    padding:20px;
}

.container{
    max-width:1000px;
    margin:auto;
    background:white;
    border-radius:15px;
    padding:25px;
    box-shadow:0 10px 25px rgba(0,0,0,0.3);
}

h1{
    text-align:center;
    color:#243b55;
    margin-bottom:20px;
}

.form-section{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
    gap:15px;
}

.input-group{
    display:flex;
    flex-direction:column;
}

label{
    font-weight:600;
    margin-bottom:5px;
}

select,input{
    padding:10px;
    border:1px solid #ccc;
    border-radius:8px;
}

.search-btn{
    width:100%;
    margin-top:20px;
    padding:12px;
    background:#243b55;
    color:white;
    border:none;
    border-radius:8px;
    cursor:pointer;
    font-size:16px;
}

.search-btn:hover{
    background:#162638;
}

.screen{
    margin-top:30px;
    text-align:center;
    background:#ddd;
    padding:10px;
    border-radius:10px;
    font-weight:bold;
}

.seats{
    display:grid;
    grid-template-columns:repeat(8,50px);
    gap:10px;
    justify-content:center;
    margin-top:20px;
}

.seat{
    width:50px;
    height:50px;
    background:#3498db;
    color:white;
    border-radius:8px;
    display:flex;
    align-items:center;
    justify-content:center;
    cursor:pointer;
    font-size:14px;
}

.seat.selected{
    background:#2ecc71;
}

.seat.booked{
    background:#e74c3c;
    cursor:not-allowed;
}

.summary{
    margin-top:25px;
    padding:15px;
    background:#f5f5f5;
    border-radius:10px;
}

.book-btn{
    width:100%;
    margin-top:15px;
    padding:12px;
    background:#27ae60;
    color:white;
    border:none;
    border-radius:8px;
    cursor:pointer;
    font-size:16px;
}

.book-btn:hover{
    background:#1e8449;
}

.confirmation{
    display:none;
    margin-top:20px;
    padding:15px;
    background:#d4edda;
    color:#155724;
    border-radius:10px;
}

.legend{
    display:flex;
    justify-content:center;
    gap:20px;
    margin-top:15px;
}

.legend div{
    display:flex;
    align-items:center;
    gap:5px;
}

.box{
    width:20px;
    height:20px;
    border-radius:4px;
}

.available{background:#3498db;}
.selected-color{background:#2ecc71;}
.booked-color{background:#e74c3c;}

</style>
</head>

<body>

<div class="container">

    <h1>🎬 Movie Ticket Booking</h1>

    <div class="form-section">

        <div class="input-group">
            <label>Movie</label>
            <select id="movie">
                <option value="250">Avengers Endgame (₹250)</option>
                <option value="200">Jawan (₹200)</option>
                <option value="180">Leo (₹180)</option>
                <option value="220">Pushpa 2 (₹220)</option>
            </select>
        </div>

        <div class="input-group">
            <label>Theater</label>
            <select id="theater">
                <option>PVR Cinemas</option>
                <option>INOX</option>
                <option>AMB Cinemas</option>
                <option>Cinepolis</option>
            </select>
        </div>

        <div class="input-group">
            <label>Date</label>
            <input type="date" id="date">
        </div>

        <div class="input-group">
            <label>Show Time</label>
            <select id="time">
                <option>10:00 AM</option>
                <option>1:00 PM</option>
                <option>4:00 PM</option>
                <option>7:00 PM</option>
            </select>
        </div>

    </div>

    <button class="search-btn">Select Seats</button>

    <div class="screen">
        SCREEN THIS WAY
    </div>

    <div class="legend">
        <div><span class="box available"></span> Available</div>
        <div><span class="box selected-color"></span> Selected</div>
        <div><span class="box booked-color"></span> Booked</div>
    </div>

    <div class="seats" id="seats"></div>

    <div class="summary">
        <h3>Booking Summary</h3>
        <br>
        <p>Selected Seats: <span id="selectedSeats">0</span></p>
        <p>Total Amount: ₹<span id="total">0</span></p>
    </div>

    <button class="book-btn" onclick="bookTickets()">
        Book Tickets
    </button>

    <div id="confirmation" class="confirmation"></div>

</div>

<script>

const seatsContainer = document.getElementById("seats");
const selectedSeatsText = document.getElementById("selectedSeats");
const totalText = document.getElementById("total");

let selectedSeats = [];

for(let i=1;i<=48;i++){

    const seat = document.createElement("div");

    seat.classList.add("seat");
    seat.innerText=i;

    if([5,8,12,17,26,30].includes(i)){
        seat.classList.add("booked");
    }

    seat.addEventListener("click",()=>{

        if(seat.classList.contains("booked")){
            return;
        }

        seat.classList.toggle("selected");

        const seatNo = seat.innerText;

        if(seat.classList.contains("selected")){
            selectedSeats.push(seatNo);
        }else{
            selectedSeats =
            selectedSeats.filter(item => item !== seatNo);
        }

        updateSummary();
    });

    seatsContainer.appendChild(seat);
}

function updateSummary(){

    const ticketPrice =
        Number(document.getElementById("movie").value);

    selectedSeatsText.innerHTML =
        selectedSeats.join(", ") || "0";

    totalText.innerHTML =
        selectedSeats.length * ticketPrice;
}

document.getElementById("movie")
.addEventListener("change",updateSummary);

function bookTickets(){

    const movie =
        document.getElementById("movie")
        .options[
        document.getElementById("movie")
        .selectedIndex].text;

    const theater =
        document.getElementById("theater").value;

    const date =
        document.getElementById("date").value;

    const time =
        document.getElementById("time").value;

    if(!date){
        alert("Please select a date");
        return;
    }

    if(selectedSeats.length===0){
        alert("Please select at least one seat");
        return;
    }

    const total =
        document.getElementById("total").innerText;

    const confirmation =
        document.getElementById("confirmation");

    confirmation.style.display="block";

    confirmation.innerHTML=`
        ✅ Booking Successful!<br><br>
        <b>Movie:</b> ${movie}<br>
        <b>Theater:</b> ${theater}<br>
        <b>Date:</b> ${date}<br>
        <b>Time:</b> ${time}<br>
        <b>Seats:</b> ${selectedSeats.join(", ")}<br>
        <b>Total Paid:</b> ₹${total}
    `;

    window.scrollTo({
        top:document.body.scrollHeight,
        behavior:"smooth"
    });
}

</script>

</body>
</html>
