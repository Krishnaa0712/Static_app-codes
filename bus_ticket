<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bus Ticket Booking System</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family: 'Segoe UI', sans-serif;
}

body{
    background: linear-gradient(135deg,#0f4c81,#2ca7d8);
    min-height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    padding:20px;
}

.container{
    width:100%;
    max-width:1000px;
    background:#fff;
    border-radius:15px;
    padding:30px;
    box-shadow:0 10px 30px rgba(0,0,0,0.2);
}

h1{
    text-align:center;
    color:#0f4c81;
    margin-bottom:25px;
}

.form-section{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
    gap:15px;
}

.input-group{
    display:flex;
    flex-direction:column;
}

label{
    font-weight:600;
    margin-bottom:5px;
}

input, select{
    padding:12px;
    border:1px solid #ccc;
    border-radius:8px;
    outline:none;
}

input:focus,
select:focus{
    border-color:#0f4c81;
}

.search-btn{
    margin-top:25px;
    width:100%;
    padding:14px;
    background:#0f4c81;
    color:#fff;
    font-size:16px;
    border:none;
    border-radius:8px;
    cursor:pointer;
}

.search-btn:hover{
    background:#093253;
}

.results{
    margin-top:30px;
}

.bus-card{
    background:#f5f9fc;
    border-left:5px solid #0f4c81;
    padding:20px;
    margin-bottom:15px;
    border-radius:10px;
}

.bus-header{
    display:flex;
    justify-content:space-between;
    flex-wrap:wrap;
}

.bus-name{
    color:#0f4c81;
    font-size:20px;
    font-weight:bold;
}

.bus-details{
    margin-top:10px;
    line-height:1.8;
}

.book-btn{
    background:#28a745;
    color:white;
    border:none;
    padding:10px 18px;
    border-radius:8px;
    cursor:pointer;
    margin-top:10px;
}

.book-btn:hover{
    background:#1f8135;
}

.confirmation{
    margin-top:20px;
    padding:15px;
    background:#d4edda;
    color:#155724;
    border-radius:8px;
    display:none;
}

.footer{
    text-align:center;
    margin-top:20px;
    color:#666;
}
</style>
</head>

<body>

<div class="container">

    <h1>🚌 Bus Ticket Booking System</h1>

    <div class="form-section">

        <div class="input-group">
            <label>From</label>
            <select id="from">
                <option value="">Select City</option>
                <option>Hyderabad</option>
                <option>Bangalore</option>
                <option>Chennai</option>
                <option>Mumbai</option>
                <option>Vijayawada</option>
            </select>
        </div>

        <div class="input-group">
            <label>To</label>
            <select id="to">
                <option value="">Select City</option>
                <option>Hyderabad</option>
                <option>Bangalore</option>
                <option>Chennai</option>
                <option>Mumbai</option>
                <option>Vijayawada</option>
            </select>
        </div>

        <div class="input-group">
            <label>Travel Date</label>
            <input type="date" id="travelDate">
        </div>

        <div class="input-group">
            <label>Passengers</label>
            <input type="number" id="passengers" value="1" min="1">
        </div>

    </div>

    <button class="search-btn" onclick="searchBuses()">
        Search Available Buses
    </button>

    <div id="results" class="results"></div>

    <div id="confirmation" class="confirmation"></div>

    <div class="footer">
        Smart Bus Reservation System
    </div>

</div>

<script>

const buses = [
{
    name:"Orange Travels",
    departure:"08:00 AM",
    arrival:"04:00 PM",
    fare:850
},
{
    name:"VRL Travels",
    departure:"10:30 AM",
    arrival:"07:00 PM",
    fare:950
},
{
    name:"Kaveri Travels",
    departure:"06:00 PM",
    arrival:"02:00 AM",
    fare:780
},
{
    name:"SRS Travels",
    departure:"09:00 PM",
    arrival:"06:00 AM",
    fare:1100
}
];

function searchBuses(){

    const from = document.getElementById("from").value;
    const to = document.getElementById("to").value;
    const date = document.getElementById("travelDate").value;

    if(!from || !to){
        alert("Please select Source and Destination.");
        return;
    }

    if(from === to){
        alert("Source and Destination cannot be the same.");
        return;
    }

    if(!date){
        alert("Please select Travel Date.");
        return;
    }

    let output = "";

    buses.forEach(bus => {

        output += `
        <div class="bus-card">

            <div class="bus-header">
                <div class="bus-name">${bus.name}</div>
                <div><strong>₹${bus.fare}</strong></div>
            </div>

            <div class="bus-details">
                Route: ${from} ➜ ${to}<br>
                Departure: ${bus.departure}<br>
                Arrival: ${bus.arrival}
            </div>

            <button
            class="book-btn"
            onclick="bookTicket('${bus.name}',${bus.fare})">
            Book Now
            </button>

        </div>
        `;

    });

    document.getElementById("results").innerHTML = output;
}

function bookTicket(busName, fare){

    const from = document.getElementById("from").value;
    const to = document.getElementById("to").value;
    const date = document.getElementById("travelDate").value;
    const passengers = document.getElementById("passengers").value;

    const totalFare = fare * passengers;

    const confirmation = document.getElementById("confirmation");

    confirmation.style.display = "block";

    confirmation.innerHTML = `
    ✅ Booking Successful!<br><br>
    <strong>Bus:</strong> ${busName}<br>
    <strong>Route:</strong> ${from} ➜ ${to}<br>
    <strong>Date:</strong> ${date}<br>
    <strong>Passengers:</strong> ${passengers}<br>
    <strong>Total Fare:</strong> ₹${totalFare}
    `;

    window.scrollTo({
        top: document.body.scrollHeight,
        behavior: 'smooth'
    });
}

</script>

</body>
</html>
